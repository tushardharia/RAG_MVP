# API Keys Configuration
# Copy this file to .env and fill in your actual values

# Required: Gemini API Key for Google Gemini services
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (only needed if using OpenAI chat service)
OPENAI_API_KEY=your_openai_api_key_here

# File Paths Configuration
# Update these paths to match your file structure
PDF_FILE_PATH=data/pdf/your_document.pdf
DATA_DIR=data
PDF_DIR=data/pdf

# Storage Configuration
# ChromaDB storage path and collection name
CHROMA_STORAGE_PATH=chroma_persistent_storage
CHROMA_COLLECTION_NAME=document_collection

# Model Configuration
# Embedding model for vector embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Gemini model name
GEMINI_MODEL_NAME=gemini-3-flash-preview
# OpenAI model name
OPENAI_MODEL_NAME=gpt-3.5-turbo

# Qdrant Configuration (optional, only needed if using Qdrant)
QDRANT_URL=http://localhost:6333
